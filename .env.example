APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=edu_dawnsynch
POSTGRES_USER=edu_dawnsynch
POSTGRES_PASSWORD=replace_with_a_unique_password
DATABASE_URL=postgresql+asyncpg://edu_dawnsynch:replace_with_a_unique_password@postgres:5432/edu_dawnsynch
ALEMBIC_DATABASE_URL=postgresql+psycopg://edu_dawnsynch:replace_with_a_unique_password@postgres:5432/edu_dawnsynch

REDIS_URL=redis://redis:6379/8
CELERY_BROKER_URL=redis://redis:6379/9
CELERY_RESULT_BACKEND=redis://redis:6379/10

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PREFIX=edu_dawnsynch
QDRANT_API_KEY=

LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace_with_existing_litellm_key
LITELLM_MODEL=replace_with_existing_model_alias
LITELLM_EMBEDDING_MODEL=replace_with_existing_embedding_alias
AI_PROMPT_VERSION=content-enrichment-v3
AI_SCHEMA_VERSION=1.0.0
AI_MIN_CONFIDENCE=0.65
AI_HTTP_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
ENRICHMENT_BATCH_SIZE=50
ADMIN_API_KEY=replace_with_a_long_random_admin_key
YOUTUBE_API_KEY=replace_with_an_official_youtube_data_api_key
INGESTION_HTTP_TIMEOUT_SECONDS=15
INGESTION_LOCK_SECONDS=900
INGESTION_MAX_RETRIES=4
RECOMMENDATION_CACHE_TTL_SECONDS=300
RECOMMENDATION_CANDIDATE_LIMIT=500

NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
API_PUBLISHED_PORT=8010
WEB_PUBLISHED_PORT=3000
SHARED_INFRA_NETWORK=enterprise-review-net
SHARED_QDRANT_NETWORK=ai-network
